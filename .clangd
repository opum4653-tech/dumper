CompileFlags:
  Add:
    - "-x"
    - "c++-header"
    - "--target=aarch64-linux-android21"
    - "-Iapp/src/main/jni"
    - "-Iapp/src/main/jni/Dobby"
    - "-Iapp/src/main/jni/imgui"
    - "-Iapp/src/main/jni/Unity"
    - "-Iapp/src/main/jni/Struct"
    - "-Iapp/src/main/jni/Core"
    - "-Iapp/src/main/jni/Icon"
    - "-Iapp/src/main/jni/xdl/include"
    - "-std=c++17"
    - "-fms-extensions"
    - "-Wno-everything"

Diagnostics:
  UnusedIncludes: None
