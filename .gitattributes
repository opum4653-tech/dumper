# Normalize line endings for everything that a Unix toolchain reads.
* text=auto

*.c            text eol=lf
*.h            text eol=lf
*.hpp          text eol=lf
*.cpp          text eol=lf
*.mk           text eol=lf
*.gradle       text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.sh           text eol=lf
gradlew        text eol=lf
*.properties   text eol=lf

# Keep binaries untouched.
*.png          binary
*.jar          binary
*.a            binary
